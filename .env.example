# ================================================================
# PTP360 Second-Pass QA -- environment variables (template)
# Copy to .env and fill in real values. .env is gitignored.
# ================================================================

# One key per feature -- get from https://console.groq.com/keys
# Tracked separately so usage/rate limits are attributable per feature, even
# though all three call the same model.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# qwen/qwen3.8-27b -- currently the vision-capable (text+image input) model
# on Groq's free tier. meta-llama/llama-4-scout-17b-16e-instruct was retired
# July 2026 -- run `node scripts/check-groq-models.js` to see what your own
# key currently has access to (look for "image" in input_modalities) before
# changing this.
GROQ_MODEL=qwen/qwen3.8-27b
